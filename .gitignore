# Dependencies & build output
node_modules/
dist/
build/
coverage/
.turbo/
.medusa/
# Next.js build output
.next/
# Logs & OS cruft
*.log
.DS_Store

# Local memory-tooling state (claude-mem / vexp) — never commit
.vexp/

# Playwright MCP debug artifacts (local only)
.playwright-mcp/

# Superpowers SDD scratch state (local only) — never commit
.superpowers/

# Claude Code agent worktrees (ephemeral, per-session parallel-agent scratch) — never commit
.claude/worktrees/

# Env files — never commit real env; templates/examples are tracked
.env
.env.*
!.env.example
!.env.template
!*.env.template

# Exported env/credential dumps (e.g. Coolify API exports) — never commit
backend_envs.json
*_envs.json

*.tsbuildinfo
